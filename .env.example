# Culture2Action 后端配置示例
# 复制为 .env 并按需填写。未配置 LLM 时，系统使用内置规则引擎生成内容，功能可完整运行。

# 服务端口
PORT=3001

# 用户自己的大模型配置（OpenAI 兼容接口）
# 请填写你自己的 Key，项目不会也不应读取平台/Agent 环境中的任何 Key
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# 强制使用规则引擎（true 时忽略 LLM 配置）
USE_RULE_ENGINE=false
